PORT=5000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/vifems_db?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"
CLIENT_URL="http://localhost:3000"
NODE_ENV="development"

# Email — Gmail SMTP (Nodemailer)
# SMTP_PASS must be a Gmail App Password, NOT your normal Gmail account password.
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="VifeMS <your-email@gmail.com>"
PASSWORD_RESET_EXPIRES_MINUTES=30

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# VifeAI Engine (RumptyCloud OpenAI-Compatible Endpoint or OpenAI)
# If omitted, dynamic semantic parser activates automatically.
RUMPTY_API_KEY=
AI_BASE_URL=https://chat.rumptycloud.com/v1
AI_MODEL=llama3.2:3b
OPENAI_API_KEY=

# Keep-alive URL (pings /api/health every 14 mins in production)
BACKEND_URL=https://vifems-backend.rumptycloud.app